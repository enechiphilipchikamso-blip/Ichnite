# ── Ichnite Environment Variables Template ──
# Copy this file to .env and fill in your real API keys
# This file is safe to commit — it contains no real keys

PORT=3000
NODE_ENV=development

# ── Solana / market providers ──
HELIUS_API_KEY=
HELIUS_BARCHART_TRANSACTION_API_KEY=
SHYFT_API_KEY=
COINGECKO_API_KEY=
CMC_API_KEY=
JUPITER_API_KEY=

# ── Network / deployment configuration ──
TRUST_PROXY=
ALLOWED_ORIGINS=
CODESPACE_NAME=

# ── Upstash Redis support state ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_KEY_PREFIX=ichnite:rate-limit:

# ── Helius wallet-activity chart tuning ──
HELIUS_CHART_PAGE_DELAY_MS=150
HELIUS_RETRY_BASE_DELAY_MS=1000
HELIUS_MAX_PAGE_RETRIES=3
HELIUS_MAX_TX_PAGES=250
HELIUS_TX_TIME_BUDGET_MS=60000
HELIUS_CHART_CACHE_TTL_MS=90000
HELIUS_CHART_CACHE_MAX_ENTRIES=200

# ── Helius NFT ownership pagination tuning ──
HELIUS_MAX_NFT_PAGES=50
HELIUS_NFT_PAGE_DELAY_MS=150
HELIUS_NFT_MAX_PAGE_RETRIES=3
HELIUS_NFT_RETRY_BASE_DELAY_MS=1000

# ── Feedback delivery ──
BREVO_API_KEY=
RESEND_API_KEY=
FEEDBACK_RECIPIENT_EMAIL=
BREVO_SENDER_EMAIL=
RESEND_SENDER_EMAIL=
FEEDBACK_SENDER_NAME=Ichnite
FEEDBACK_REDIS_KEY_PREFIX=ichnite:feedback: